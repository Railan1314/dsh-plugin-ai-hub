{
  "version": 1,
  "base": "/dsh-console/api",
  "auth": "local-only",
  "description": "AI Console 本机统一接口；QQ 机器人、插件和 agent 共用。",
  "endpoints": [
    {"method": "GET", "path": "/status", "description": "完整状态：任务、并发、模型、Token、jobs"},
    {"method": "GET", "path": "/progress", "description": "QQ bot 用的一体化进度：DSH 会话、任务、jobs、总指挥"},
    {"method": "GET", "path": "/progress/text", "description": "纯文本进度摘要；可带 id 查单会话，QQ bot 可直接推送"},
    {"method": "GET", "path": "/progress/session?id=", "description": "按会话 ID 查详细进度：轮次/步骤/上下文/token/最近一轮"},
    {"method": "GET", "path": "/health", "description": "健康守护状态、免费模型巡检、job 状态计数"},
    {"method": "GET", "path": "/tasks", "description": "任务列表与控制动作"},
    {"method": "POST", "path": "/tasks", "body": {"id": "desc|map|art|balance", "op": "start|stop|restart"}, "description": "任务控制"},
    {"method": "GET", "path": "/jobs", "description": "异步任务列表，支持 state 过滤"},
    {"method": "GET", "path": "/jobs/:id", "description": "单个异步任务详情，含结果和错误"},
    {"method": "GET", "path": "/queue", "description": "主动调度队列，可用 state 过滤（queued/dispatched/done）"},
    {"method": "GET", "path": "/logs?lines=", "description": "最近的 job/事件日志，供排查停工"},
    {"method": "POST", "path": "/jobs", "body": {"type": "opencode|free|external", "title": "", "prompt": "", "model": "", "account": "", "keyName": "", "idempotencyKey": ""}, "description": "创建异步任务"},
    {"method": "POST", "path": "/event", "body": {"jobId": "", "state": "succeeded|failed|stale", "result": ""}, "description": "完成事件回写"},
    {"method": "POST", "path": "/jobs/:id/cancel", "description": "取消异步任务"},
    {"method": "POST", "path": "/inject", "body": {"sessionId": "", "text": ""}, "description": "向会话投递消息"},
    {"method": "GET", "path": "/commander", "description": "总指挥目标、任务卡和报告列表"},
    {"method": "POST", "path": "/commander/goal", "body": {"goal": ""}, "description": "创建一个总指挥目标，后台拆解"},
    {"method": "GET", "path": "/commander/report?name=", "description": "读取总指挥报告正文"},
    {"method": "GET", "path": "/opencode/free-models", "description": "本机 OpenCode 客户端可用免费模型（去重）"},
    {"method": "GET", "path": "/model-eval", "description": "扩展模型评测结果：鹈鹕/逻辑/JSON/长上下文/代码/工具诚实度"},
    {"method": "POST", "path": "/model-eval/run", "body": {"model": "", "baseUrl": "", "key": "", "provider": ""}, "description": "后台运行一次扩展评测，结果写 model-eval"},
    {"method": "GET", "path": "/registration", "description": "免费模型注册入口和探测字段；只读，不自动提交"},
    {"method": "GET", "path": "/a2a/agent-card", "description": "A2A agent card，供其他 agent 发现能力"},
    {"method": "GET", "path": "/route?role=", "description": "按角色返回推荐模型和候选；供外部 agent 复用路由"},
    {"method": "GET", "path": "/providers", "description": "统一 provider/model 来源"},
    {"method": "GET", "path": "/free-models", "description": "免费模型登记，q 搜索"},
    {"method": "GET", "path": "/local-search?q=", "description": "本地资料检索，优先命中缓存，减少联网"},
    {"method": "GET", "path": "/xdpool", "description": "XD Pool 伴侣只读状态"}
  ]
}
