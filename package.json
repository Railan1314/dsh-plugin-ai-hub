{
  "name": "dsh-plugin-ai-hub",
  "version": "2.8.1",
  "private": false,
  "description": "AI 调度台（主机）：密钥池 / 并发 / 任务注册 / 大肥鱼；任务由 DLC 插件注册",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "api_manifest.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Railan1314/dsh-plugin-ds-console.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "ai-hub",
    "model-pool",
    "opencode"
  ]
}
