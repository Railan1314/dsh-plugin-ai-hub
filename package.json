{
  "name": "dsh-plugin-ai-hub",
  "version": "2.9.8",
  "private": false,
  "displayName": "AI Dispatch Console",
  "description": "AI Dispatch Console (AI 调度台): a DSH side-panel for key pools, concurrency, job dispatch, free-model radar and MCP bridge.",
  "type": "module",
  "main": "index.js",
  "license": "AGPL-3.0",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "api_manifest.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Railan1314/dsh-plugin-ai-hub.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "ai-hub",
    "model-pool",
    "opencode"
  ]
}
